PROJECT_NAME=perry-telegram
IMAGE_NAME=perry-telegram:latest
HOST_PORT=8000
APP_PORT=8000

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
TELEGRAM_API_BASE=https://api.telegram.org

AGENT_API_URL=https://your-engine.example.com
AGENT_API_KEY=your-agent-api-key
AGENT_TIMEOUT_SECONDS=120
TELEGRAM_MESSAGE_DEBOUNCE_SECONDS=0.5
TELEGRAM_THINKING_ROTATION_SECONDS=5

OUTBOUND_API_KEY=your-outbound-api-key

# Optional: enables webhook registration on startup.
PUBLIC_BASE_URL=https://your-public-host.example.com
LOG_LEVEL=INFO
# Raw message/callback content is retained in audit.jsonl by default.
AUDIT_LOG_RAW_CONTENT=true
LOG_DIRECTORY=/logs
